{
  "name": "as-folio",
  "description": "A clean, responsive Astro theme for academics and researchers",
  "version": "2.0.1",
  "author": "Dadang NH <hello@dadangnh.com>",
  "homepage": "https://github.com/dadangnh/as-folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/dadangnh/as-folio"
  },
  "bugs": {
    "url": "https://github.com/dadangnh/as-folio/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "astro-component",
    "academic",
    "portfolio",
    "template",
    "as-folio",
    "bibtex",
    "publications"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src/",
    "public/",
    "astro.config.mjs",
    "tsconfig.json",
    ".prettierrc.yaml",
    "bunfig.toml",
    "netlify.toml",
    "vercel.json",
    "QUICKSTART.md",
    "CUSTOMIZE.md",
    "MIGRATE.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "astro": ">=6.4.0"
  },
  "scripts": {
    "dev": "bun --bun astro dev",
    "start": "bun --bun astro dev",
    "prebuild": "bun scripts/update-citations.ts",
    "build": "bun --bun astro build --timings && pagefind --site dist",
    "build:verify": "bun --bun astro build && pagefind --site dist",
    "preview": "bun --bun astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --quiet",
    "test": "bun --bun vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "astro check && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=junit",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:visual:docker": "bash scripts/visual-docker.sh",
    "test:all": "bun run test:types && bun run lint:ci && bun run test && bun run test:e2e",
    "validate": "bun run test:all",
    "prepare": "husky",
    "citations:update": "bun scripts/update-citations.ts",
    "compare:dist": "bun scripts/compare-dist.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-regular": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.4.8",
    "js-yaml": "^4.3.2",
    "katex": "0.16.42",
    "medium-zoom": "^1.1.2",
    "ninja-keys": "^1.2.2",
    "pseudocode": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "unplugin-icons": "^23.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.61.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "7.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "0.16.42"
  }
}
